# Railway → Spring Boot service variables (copy into Railway Variables tab)
# Replace placeholders before deploy.

SPRING_PROFILES_ACTIVE=prod

# Railway may provide either URL form. The app normalizes postgresql:// URLs automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
# Optional when DATABASE_URL already contains credentials:
DATABASE_USERNAME=
DATABASE_PASSWORD=

JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

APP_BASE_URL=https://api.roombay.app
APP_FRONTEND_URL=https://www.roombay.app
CORS_ALLOWED_ORIGINS=https://www.roombay.app,https://roombay.app

APP_OAUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hetzner VPS public IP
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://YOUR_VPS_IP:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
AI_DOCS_DIR=/app/docs

# After OpenSearch/Elasticsearch is provisioned on VPS:
ROOMBAY_SEARCH_ELASTICSEARCH_ENABLED=true
SPRING_ELASTICSEARCH_URIS=http://YOUR_VPS_IP:9200
# Run POST /api/admin/search/reindex once after first enable

# Redis — distributed rate limiting across Railway replicas (listing index uses Postgres outbox, not Redis queue)
SPRING_DATA_REDIS_ENABLED=true
REDIS_HOST=YOUR_VPS_IP
REDIS_PORT=6379
# REDIS_PASSWORD=
RATELIMIT_REDIS_REQUIRED=true
ROOMBAY_HORIZONTAL_SCALING_ENABLED=true

ROOMBAY_AI_INGEST_DEV_KEY=
APP_DEV_SEED_LANDLORD_ENABLED=false

# LangGraph orchestrator sidecar (optional; run on Hetzner VPS — see docs/deploy/production-deploy.md).
# Generate once: openssl rand -hex 32 — use the same value on VPS (ROOMBAY_INTERNAL_TOKEN).
ROOMBAY_AI_ORCHESTRATOR_ENABLED=false
# VPS public IP or hostname, e.g. http://YOUR_VPS_IP:8131
ROOMBAY_AI_ORCHESTRATOR_BASE_URL=
ROOMBAY_AI_ORCHESTRATOR_TIMEOUT_MS=20000
ROOMBAY_AI_INTERNAL_TOKEN=

# Set real platform MoMo numbers before accepting payments
ROOMBAY_PLATFORM_MTN_MOMO=
ROOMBAY_PLATFORM_ORANGE_MONEY=

# SENTRY_DSN=
