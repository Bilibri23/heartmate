# Hetzner VPS environment template for deploy/docker-compose.vps.yml
# Copy to ~/roombay/.env on the VPS. Never commit a real .env.

# --- LangGraph orchestrator (ai-orchestrator service) ---
# Public Railway API URL the sidecar calls for read-only internal tools.
ROOMBAY_API_BASE_URL=https://api.roombay.app
# Must match Railway ROOMBAY_AI_INTERNAL_TOKEN exactly.
ROOMBAY_INTERNAL_TOKEN=

# LLM for orchestrator generation (reuse VPS Ollama).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OPENAI_API_KEY=

# --- Optional overrides for other VPS services ---
# SPRING_ELASTICSEARCH_URIS is not used on VPS; Railway connects to ES if enabled.
