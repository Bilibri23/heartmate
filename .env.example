# RoomBuddy Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =====================================================
# DATABASE
# =====================================================
# Render provides these when you create a PostgreSQL database
POSTGRES_DB=roombuddy
POSTGRES_USER=roombuddy
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=jdbc:postgresql://localhost:5432/roombuddy
DATABASE_USERNAME=roombuddy
DATABASE_PASSWORD=your_secure_password_here

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=generate-a-strong-random-secret-at-least-64-characters-long-for-production

# =====================================================
# CLOUDINARY (Image Uploads)
# =====================================================
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =====================================================
# EMAIL (SMTP)
# =====================================================
# For Gmail: Enable 2FA and create an App Password
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# =====================================================
# WHATSAPP BUSINESS API (Optional)
# =====================================================
WHATSAPP_API_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# =====================================================
# APPLICATION
# =====================================================
APP_BASE_URL=http://localhost:3000
SERVER_PORT=8082

# =====================================================
# CORS (Production)
# =====================================================
# Comma-separated list of allowed origins for production
# Example: https://roombuddy-frontend.onrender.com,https://roombuddy.com
CORS_ALLOWED_ORIGINS=

# =====================================================
# SPRING PROFILE (set to 'prod' for production)
# =====================================================
SPRING_PROFILES_ACTIVE=default

# =====================================================
# FRONTEND
# =====================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8082/api
NEXT_PUBLIC_API_URL=/api
