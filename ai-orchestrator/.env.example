# RoomBay AI Orchestrator — environment template. Copy to .env for local runs.
# Never commit a real .env.

# --- RoomBay Spring backend (internal tool calls) ---
ROOMBAY_API_BASE_URL=http://localhost:8082
# Shared secret; must equal Spring's roombay.ai.orchestrator.token.
ROOMBAY_INTERNAL_TOKEN=change-me-internal-token
TOOL_TIMEOUT_MS=8000

# --- LLM provider: openai | ollama | stub ---
# "stub" needs no model and returns deterministic text (good for first boot/tests).
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
LLM_TIMEOUT_MS=60000

# --- Feedback-loop tuning ---
GROUNDING_RETRY_CAP=1
LISTING_RETRY_CAP=1
SELF_CHECK_REGEN_CAP=1
GROUNDING_MIN_SCORE=0.2

# --- Service ---
PORT=8131
LOG_LEVEL=INFO
