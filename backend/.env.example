# Copy to .env and fill in values. Never commit .env.
# AI_DOCS_DIR: use "docs" when Spring cwd is repo root (typical IDE); use "../docs" when cwd is backend/.

DATABASE_URL=jdbc:postgresql://localhost:5433/roomconnect_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_OR_RANDOM_SECRET_MIN_32_BYTES

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

APP_BASE_URL=http://localhost:8082
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google OAuth (web app)
# Authorized redirect URI examples:
# - Local backend: http://localhost:8082/login/oauth2/code/google
# - Production (Vercel OAuth proxy): https://www.roombay.com/login/oauth2/code/google
#   Also add https://roombay.com/... if apex serves the frontend.
APP_OAUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SPRING_PROFILES_ACTIVE=default

# --- AI / RAG (local Ollama) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text = 768; OpenAI text-embedding-3-small = 1536
# AI_EMBEDDING_DIMENSIONS=768
AI_DOCS_DIR=docs

# Leave unset to force Ollama only via AI_PROVIDER=ollama
# OPENAI_API_KEY=

# Local RAG ingest without an admin: long random string; use scripts/rag-ingest-local.ps1 (no -Token).
# GET /api/ai/graph-stats-dev uses the same header for counts after ingest (admin route is /api/ai/admin/graph-stats).
# Never set in production deployments.
# ROOMBAY_AI_INGEST_DEV_KEY=

# GraphRAG hybrid retrieval (default on). Set false to use flat vector top-K only.
# ROOMBAY_AI_GRAPH_RAG=true

# Short-term chat memory (LangGraph). Keep disabled unless LangGraph service is running.
# ROOMBAY_AI_MEMORY_ENABLED=false
# ROOMBAY_AI_MEMORY_PROVIDER=langgraph
# ROOMBAY_AI_MEMORY_MAX_TURNS=6
# ROOMBAY_AI_MEMORY_TIMEOUT_MS=2000
# ROOMBAY_AI_MEMORY_LANGGRAPH_BASE_URL=http://localhost:8123
# ROOMBAY_AI_MEMORY_LANGGRAPH_API_KEY=

# Optional: disable Elasticsearch locally if you do not run ES
# roombay.search.elasticsearch.enabled=false

# Production platform MoMo (when landlord has no number on file)
# ROOMBAY_PLATFORM_MTN_MOMO=
# ROOMBAY_PLATFORM_ORANGE_MONEY=

# Production profile
# SPRING_PROFILES_ACTIVE=prod
