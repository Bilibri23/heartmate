# Copy to .env and fill in values. Never commit .env.
# AI_DOCS_DIR: use "docs" when Spring cwd is repo root (typical IDE); use "../docs" when cwd is backend/.

DATABASE_URL=jdbc:postgresql://localhost:5433/roomconnect_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_OR_RANDOM_SECRET_MIN_32_BYTES

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

APP_BASE_URL=http://localhost:8082
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SPRING_PROFILES_ACTIVE=default

# --- AI / RAG (local Ollama) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text = 768; OpenAI text-embedding-3-small = 1536
# AI_EMBEDDING_DIMENSIONS=768
AI_DOCS_DIR=docs

# Leave unset to force Ollama only via AI_PROVIDER=ollama
# OPENAI_API_KEY=

# Local RAG ingest without an admin: long random string; use scripts/rag-ingest-local.ps1 (no -Token).
# Never set in production deployments.
# ROOMBAY_AI_INGEST_DEV_KEY=

# Optional: disable Elasticsearch locally if you do not run ES
# roombay.search.elasticsearch.enabled=false
