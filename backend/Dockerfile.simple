# RoomBay Backend Dockerfile - Simple Version
# This version assumes you've already built the JAR locally with: mvn clean package
# Use this if the multi-stage build is too slow on your machine
#
# Build command: docker build -f backend/Dockerfile.simple -t roombay-backend .

FROM eclipse-temurin:17-jre-alpine

# Add labels
LABEL maintainer="RoomBay Team"
LABEL version="1.0.0"
LABEL description="RoomBay Backend API - Student Housing Platform"

# Create non-root user for security
RUN addgroup -g 1001 -S roombay && \
    adduser -u 1001 -S roombay -G roombay

WORKDIR /app

# Copy the pre-built JAR from your local target/ directory
COPY target/*.jar app.jar

# Change ownership to non-root user
RUN chown -R roombay:roombay /app

# Switch to non-root user
USER roombay

# Expose the application port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# JVM optimization for containers
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0"

# Run the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
